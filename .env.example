# ==========================================
# AutoSupply Hub — Environment Configuration
# ==========================================

# Application Environment (development, test, production)
APP_ENV=development

# Database Settings (Granular host / volume mount settings)
DB_HOST=database-1.cperf7tnhj6s.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_NAME=autosupply_component
DB_PASSWORD_FILE=/mnt/secrets-store/db_password
DB_PASSWORD=autosupply

# Service-specific database names
AUTH_DB_NAME=autosupply_auth
SUPPLIER_DB_NAME=autosupply_supplier
COMPONENT_DB_NAME=autosupply_component
ORDER_DB_NAME=autosupply_order

# Legacy container database settings
POSTGRES_USER=autosupply
POSTGRES_PASSWORD=autosupply
POSTGRES_DB=autosupply
DATABASE_URL=postgresql+psycopg://autosupply:autosupply@localhost:5432/autosupply
TEST_DATABASE_URL=postgresql+psycopg://autosupply:autosupply@localhost:5432/autosupply_test

# Security & JWT (generate a secure random 32+ character secret for production)
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS & Frontend Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Next.js Frontend (browser-accessible API endpoint)
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Provider Configuration (for Phase 5)
AI_PROVIDER=none
AI_API_KEY=
